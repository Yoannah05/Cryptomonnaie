        <thead>
            <tr>
                <th>Cryptomonnaie</th>
                <th>Symbole</th>
                <th>Cours (USD)</th>
            </tr>
        </thead>
        <tbody id="crypto-data">
            <tr>
                <td colspan="3" class="text-center">Chargement des données...</td>
            </tr>
        </tbody>
    </table>
</div>

